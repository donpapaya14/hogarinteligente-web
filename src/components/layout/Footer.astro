---
const year = new Date().getFullYear();
const categories = [
  { href: '/categoria/smart-home',    label: 'Smart Home' },
  { href: '/categoria/kitchen',       label: 'Kitchen' },
  { href: '/categoria/cleaning',      label: 'Cleaning' },
  { href: '/categoria/organization',  label: 'Organization' },
  { href: '/categoria/energy-saving', label: 'Energy Saving' },
];
const legal = [
  { href: '/legal-notice',   label: 'Legal' },
  { href: '/privacy-policy', label: 'Privacy' },
  { href: '/cookie-policy',  label: 'Cookies' },
];
const sites = [
  { href: 'https://vida-sana-360.com',   label: 'VidaSana360' },
  { href: 'https://saludlongevidad.org', label: 'SaludLongevidad' },
  { href: 'https://finanzasclara.uk',    label: 'FinanzasClara' },
  { href: 'https://catbrothers.uk',      label: 'CatBrothers' },
  { href: 'https://cash-cafe.org',       label: 'Cash Café' },
];
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <a href="/" class="topbar__brand" style="text-decoration:none;display:inline-flex;align-items:center;gap:12px">
        <span class="brand-mark" aria-hidden="true">EI</span>
        <span class="brand-name" style="color:#fff">Espacio<em>Inteligente</em></span>
      </a>
      <p class="lede" style="font-size:13px;margin-top:12px;max-width:360px;color:rgba(255,255,255,0.72)">
        An editorial smart home magazine. Honest gear, energy savings and practical home tech — backed by real specs.
      </p>
    </div>

    <nav class="site-footer__col" aria-label="Categories">
      <h4>Categories</h4>
      <ul>
        {categories.map(c => <li><a href={c.href}>{c.label}</a></li>)}
      </ul>
    </nav>

    <nav class="site-footer__col" aria-label="Connect">
      <h4>Connect</h4>
      <ul>
        <li><a href="https://www.youtube.com/@EspacioInteligente-q2q" target="_blank" rel="noopener">YouTube</a></li>
        <li><a href="/rss.xml">RSS</a></li>
        <li><a href="/about">About</a></li>
      </ul>
    </nav>

    <nav class="site-footer__col site-footer__col--sites" aria-label="Our sites">
      <h4>Our sites</h4>
      <ul>
        {sites.map(s => (
          <li><a href={s.href} target="_blank" rel="noopener">{s.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>

  <div class="site-footer__bar">
    <div class="container site-footer__bar-inner">
      <span class="micro" style="color:rgba(255,255,255,0.6)">&copy; {year} EspacioInteligente · Smart home magazine · Affiliate links may be included</span>
      <ul class="site-footer__legal">
        {legal.map(l => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid rgba(14, 165, 233, 0.18);
    padding: 56px 0 0;
    margin-top: 64px;
    background: var(--slate-deep);
    color: rgba(255, 255, 255, 0.72);
    position: relative;
    overflow: hidden;
  }
  .site-footer::before {
    content: ""; position: absolute; inset: 0; pointer-events: none;
    background:
      radial-gradient(ellipse 50% 80% at 0% 0%, rgba(14, 165, 233, 0.12) 0%, transparent 60%),
      radial-gradient(ellipse 60% 80% at 100% 100%, rgba(99, 102, 241, 0.10) 0%, transparent 60%);
  }
  .site-footer__inner,
  .site-footer__bar { position: relative; z-index: 1; }
  .site-footer__inner {
    display: grid;
    grid-template-columns: 1.5fr repeat(3, 1fr);
    gap: 32px;
    padding-bottom: 40px;
  }
  .site-footer__col h4 {
    color: #fff;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-bottom: 14px;
  }
  .site-footer__col ul { list-style: none; padding: 0; margin: 0; }
  .site-footer__col li { margin-bottom: 8px; }
  .site-footer__col a {
    color: rgba(255, 255, 255, 0.72);
    font-size: 13.5px;
    text-decoration: none;
    transition: color 0.15s;
  }
  .site-footer__col a:hover { color: var(--accent); }

  .site-footer__bar {
    border-top: 1px solid rgba(255, 255, 255, 0.10);
    padding: 18px 0 28px;
  }
  .site-footer__bar-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
  }
  .site-footer__legal {
    list-style: none;
    display: flex;
    gap: 18px;
    margin: 0;
    padding: 0;
  }
  .site-footer__legal a {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.5);
    text-decoration: none;
  }
  .site-footer__legal a:hover { color: #fff; }

  @media (max-width: 880px) {
    .site-footer__inner {
      grid-template-columns: 1fr 1fr;
      gap: 28px;
    }
    .site-footer__brand { grid-column: 1 / -1; }
  }
  @media (max-width: 520px) {
    .site-footer__inner { grid-template-columns: 1fr; }
    .site-footer__bar-inner { justify-content: flex-start; }
  }
</style>
