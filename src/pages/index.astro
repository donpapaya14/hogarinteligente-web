---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/content/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES } from '../utils/categories';
import type { Category } from '../utils/categories';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const latestPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);

const categories = Object.entries(CATEGORIES) as [Category, (typeof CATEGORIES)[Category]][];
---

<BaseLayout title="EspacioInteligente" description="Smart home magazine. Honest gear reviews, energy savings, kitchen tech and home automation — backed by real specs.">
  <!-- Hero -->
  <section class="hero">
    <div class="container hero__inner hero-grid">
      <div class="hero-text">
        <div class="eyebrow">A smart home magazine</div>
        <h1 class="display hero__title">
          Your home,<br />
          <em>quietly smarter</em>
        </h1>
        <p class="lede hero__subtitle">
          Real-world reviews of smart speakers, kitchen tech and energy savers.
          No hype, no fluff — just specs, savings and what actually works.
        </p>
        <div class="hero__actions">
          <a href="/blog" class="btn-primary">Read articles &rarr;</a>
          <a href="#categories" class="btn-ghost">Explore categories</a>
        </div>

        <div class="pop-chips" aria-label="Popular topics">
          <span class="pop-chips-label">Popular</span>
          <a href="/categoria/smart-home" class="pop-chip">Smart Home</a>
          <a href="/categoria/energy-saving" class="pop-chip">Energy savings</a>
          <a href="/categoria/kitchen" class="pop-chip">Kitchen tech</a>
          <a href="/categoria/cleaning" class="pop-chip">Cleaning hacks</a>
          <a href="/categoria/organization" class="pop-chip">Organization</a>
        </div>
      </div>

      <div class="hero-visual" aria-hidden="true">
        <img
          src="https://images.pexels.com/photos/1571460/pexels-photo-1571460.jpeg?auto=compress&cs=tinysrgb&w=1200&fit=crop"
          alt=""
          loading="eager"
          decoding="async"
        />
        <div class="hero-spec">
          <div class="hero-spec__row"><span class="hero-spec__k">Energy saved</span><span class="hero-spec__v">−32% kWh</span></div>
          <div class="hero-spec__row"><span class="hero-spec__k">Noise floor</span><span class="hero-spec__v">28 dB</span></div>
          <div class="hero-spec__row"><span class="hero-spec__k">Standard</span><span class="hero-spec__v">Matter 1.4</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Latest Articles -->
  <section class="section">
    <div class="container">
      <div class="section__header">
        <div>
          <div class="eyebrow">Recent</div>
          <h2 class="section-title">Latest articles</h2>
        </div>
        <a href="/blog" class="section__link">See all &rarr;</a>
      </div>
      <div class="articles-grid">
        {latestPosts.map(post => (
          <ArticleCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            category={post.data.category}
            slug={post.id}
            image={post.data.image}
            readingTime={post.data.readingTime}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Stats — dark slate section with big tech numbers -->
  <section class="section section--dark">
    <div class="container">
      <div style="text-align:center;margin-bottom:36px;position:relative;z-index:1">
        <div class="eyebrow" style="justify-content:center;color:#fff">Real data, real homes</div>
        <h2 class="section-title">Smart upgrades, measured</h2>
        <p class="lede" style="margin:14px auto 0;max-width:560px">
          Every guide is backed by real-world numbers — energy bills, decibels and standards you can verify.
        </p>
      </div>
      <div class="stats-strip">
        <div class="stat">
          <div class="stat__num">−32%</div>
          <div class="stat__label">Avg. kWh saved</div>
        </div>
        <div class="stat">
          <div class="stat__num">28 dB</div>
          <div class="stat__label">Quietest tested</div>
        </div>
        <div class="stat">
          <div class="stat__num">7</div>
          <div class="stat__label">Smart standards</div>
        </div>
        <div class="stat">
          <div class="stat__num">100%</div>
          <div class="stat__label">Honest reviews</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Categories -->
  <section id="categories" class="section section--alt">
    <div class="container">
      <div style="text-align:center;margin-bottom:36px">
        <div class="eyebrow" style="justify-content:center">Explore</div>
        <h2 class="section-title">By category</h2>
      </div>
      <div class="categories-grid">
        {categories.map(([key, cat]) => (
          <a href={`/categoria/${key}`} class={`cat-card cat-card--${key}`}>
            <h3>{cat.name}</h3>
            <p>{cat.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- YouTube CTA -->
  <section class="section">
    <div class="container yt-section">
      <div class="eyebrow" style="justify-content:center">YouTube</div>
      <h2 class="section-title">Smart home tips in 60 seconds</h2>
      <p class="lede" style="margin:14px auto 24px;max-width:520px">
        Daily shorts with honest reviews and quick wins for your home.
      </p>
      <a href="https://youtube.com/@EspacioInteligente" target="_blank" rel="noopener" class="btn-primary btn--lg">
        Visit channel &rarr;
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 48px;
    align-items: center;
  }
  .hero-text { max-width: 640px; }
  .hero__title em { font-style: italic; color: var(--accent); }

  .hero-visual {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    aspect-ratio: 4/5;
    background: var(--bg-soft);
    box-shadow: var(--shadow-lg);
    border: 1px solid var(--line);
  }
  .hero-visual img {
    width: 100%; height: 100%;
    object-fit: cover;
  }
  .hero-spec {
    position: absolute;
    bottom: 18px; left: 18px; right: 18px;
    background: rgba(15, 23, 42, 0.78);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 14px;
    padding: 14px 16px;
    color: #fff;
    display: flex; flex-direction: column; gap: 6px;
    font-family: var(--font-mono);
    font-size: 12px;
  }
  .hero-spec__row {
    display: flex; justify-content: space-between; align-items: center;
    gap: 12px;
  }
  .hero-spec__k {
    color: rgba(255, 255, 255, 0.62);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 10.5px;
  }
  .hero-spec__v {
    color: var(--accent);
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .yt-section {
    text-align: center;
    max-width: 620px;
    margin: 0 auto;
  }

  /* Per-category accent edge */
  .cat-card--kitchen        { box-shadow: inset 4px 0 0 #16A34A, var(--shadow-sm); }
  .cat-card--smart-home     { box-shadow: inset 4px 0 0 var(--accent), var(--shadow-sm); }
  .cat-card--organization   { box-shadow: inset 4px 0 0 var(--accent-secondary), var(--shadow-sm); }
  .cat-card--cleaning       { box-shadow: inset 4px 0 0 #06B6D4, var(--shadow-sm); }
  .cat-card--energy-saving  { box-shadow: inset 4px 0 0 var(--accent-warm), var(--shadow-sm); }

  @media (max-width: 980px) {
    .hero-grid { grid-template-columns: 1fr; gap: 36px; }
    .hero-visual { aspect-ratio: 16/10; max-width: 560px; }
  }
  @media (max-width: 600px) {
    .hero__actions { flex-direction: column; align-items: stretch; }
    .hero__actions .btn-primary,
    .hero__actions .btn-ghost { width: 100%; justify-content: center; }
  }
</style>
